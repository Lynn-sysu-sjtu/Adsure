# Non-secret RAG service configuration.
# 2026-09-15: hybrid + min_semantic 0.50（30 条评测回归：预期命中率 4% -> 10%）。
CASE_ENGINE_INDEX_SCOPE=production
CASE_ENGINE_DATA_DIR=/opt/adsure-rag/data
CASE_ENGINE_MAX_CONTENT_LENGTH=20000
CASE_ENGINE_MIN_RELATIVE_SCORE=0.25
CASE_ENGINE_MIN_QUERY_COVERAGE=0.25
CASE_ENGINE_RETRIEVAL_MODE=hybrid
CASE_ENGINE_MIN_SEMANTIC_SCORE=0.50
CASE_ENGINE_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
CASE_ENGINE_EMBEDDING_ALLOW_DOWNLOAD=0
# Set to 1 only when startup must fail instead of falling back to lexical retrieval.
CASE_ENGINE_REQUIRE_SEMANTIC=0
HF_HOME=/opt/adsure-rag/models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Put ADSURE_API_KEY in /etc/adsure/rag-secret.env on the server.
# Never commit that secret file.
