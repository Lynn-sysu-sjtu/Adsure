# Local-only Zhipu key template for rebuilding the semantic index.
# 1) 复制成 .env.zhipu.local（该文件已被 .gitignore 忽略，不会提交）
# 2) 把下面 ZHIPU_API_KEY 的空值填成你的智谱 Key（不要加引号）
# 3) 执行：bash scripts/rebuild_zhipu_index.sh
# 云服务器上请改用 /etc/adsure/rag-secret.env，不要放仓库目录。
# NEVER commit .env.zhipu.local or any real key.

ZHIPU_API_KEY=

# 可选：旧字段，留空即可（脚本优先读 ZHIPU_API_KEY）
CASE_ENGINE_EMBEDDING_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
