{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adsure.local/schemas/platform_rule_candidate_catalog_v1.schema.json",
  "title": "Adsure Platform Rule Candidate Catalog v1",
  "type": "object",
  "required": ["catalog_id", "created_at", "catalog_status", "candidate_count", "rules"],
  "properties": {
    "catalog_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "catalog_status": {"const": "candidate_only_not_for_production"},
    "candidate_count": {"type": "integer", "minimum": 1},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "source_id",
          "platform",
          "document_title",
          "source_url",
          "manual_verification_url",
          "locator",
          "rule_summary",
          "risk_dimensions",
          "evidence_excerpt",
          "evidence_excerpt_type",
          "retrieval_text",
          "raw_text_path",
          "raw_sha256",
          "effective_status",
          "review_status",
          "release_eligibility",
          "human_review_required"
        ],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "document_title": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"},
          "manual_verification_url": {"type": "string", "format": "uri"},
          "locator": {"type": "string", "minLength": 1},
          "rule_summary": {"type": "string", "minLength": 1},
          "risk_dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_excerpt": {"type": "string", "minLength": 1},
          "evidence_excerpt_type": {"const": "short_visible_text_excerpt"},
          "retrieval_text": {"type": "string", "minLength": 30},
          "raw_text_path": {"type": "string", "minLength": 1},
          "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "effective_status": {"const": "pending_effective_review"},
          "review_status": {"const": "pending_legal_review"},
          "release_eligibility": {"const": "candidate_only"},
          "human_review_required": {"const": true}
        }
      }
    }
  }
}
