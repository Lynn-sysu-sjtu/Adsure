# Server-side secret environment file.
# Copy to /etc/adsure/rag-secret.env on the Linux server.
# NEVER commit the filled file.

# RAG service API key (required).
ADSURE_API_KEY=change-me

# Zhipu BigModel API key for embedding-3 (required in production).
ZHIPU_API_KEY=change-me

# Optional: separate embedding key. If empty, ZHIPU_API_KEY is used.
CASE_ENGINE_EMBEDDING_API_KEY=

# Optional: override the Zhipu API base URL.
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
