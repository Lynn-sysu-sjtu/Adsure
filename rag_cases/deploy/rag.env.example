# Non-secret RAG service configuration.
# 2026-09-15: hybrid + min_semantic 0.50（30 条评测回归：预期命中率 4% -> 10%）。
CASE_ENGINE_INDEX_SCOPE=production
CASE_ENGINE_DATA_DIR=/opt/adsure-rag/data
CASE_ENGINE_MAX_CONTENT_LENGTH=20000
CASE_ENGINE_MIN_RELATIVE_SCORE=0.25
CASE_ENGINE_MIN_QUERY_COVERAGE=0.25
CASE_ENGINE_RETRIEVAL_MODE=hybrid
CASE_ENGINE_MIN_SEMANTIC_SCORE=0.50
# 向量编码器：local（本地 bge）或 zhipu（智谱 BigModel embedding API）。
# NOTE: 仓库内 production_semantic_index.json 是 BAAI/bge-base-zh-v1.5（768 维）。
# 生产要求 provider=zhipu + embedding-3 + 2048 维，语义索引必须由同一 provider 重建。
# 当前仓库若仍是 BAAI 768 维，先在云端执行 bash scripts/rebuild_zhipu_index.sh。
# 2026-09-20 起默认改为智谱 API，无需在服务器下载/缓存本地模型。
CASE_ENGINE_EMBEDDING_PROVIDER=zhipu
CASE_ENGINE_EMBEDDING_MODEL=embedding-3
CASE_ENGINE_ZHIPU_EMBEDDING_MODEL=embedding-3
CASE_ENGINE_EMBEDDING_DIMENSIONS=2048
CASE_ENGINE_EMBEDDING_BATCH_SIZE=32
CASE_ENGINE_EMBEDDING_ALLOW_DOWNLOAD=0
# 切回本地 bge：PROVIDER=local、MODEL=BAAI/bge-base-zh-v1.5，并保留下面 HF_HOME。
# Set to 1 only when startup must fail instead of falling back to lexical retrieval.
CASE_ENGINE_REQUIRE_SEMANTIC=1
HF_HOME=/opt/adsure-rag/models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Put ADSURE_API_KEY in /etc/adsure/rag-secret.env on the server.
# Never commit that secret file.

# 密钥放入服务器 /etc/adsure/rag-secret.env（不要提交）：
#   ADSURE_API_KEY=...           服务对外鉴权
#   ZHIPU_API_KEY=...            智谱 BigModel API Key（embedding-3）
# 也可用 CASE_ENGINE_EMBEDDING_API_KEY 单独指定 embedding 密钥。
