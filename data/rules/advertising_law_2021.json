{
  "catalog_id": "advertising_law_2021",
  "law_name": "中华人民共和国广告法",
  "version_date": "2021-04-29",
  "effective_status": "有效",
  "source_name": "国家市场监督管理总局",
  "source_url": "https://www.samr.gov.cn/zw/zfxxgk/fdzdgknr/fgs/art/2023/art_5474cf75173c45d6a0379730fb4e8d97.html",
  "rule_text_mode": "normalized_summary_not_verbatim",
  "rules": [
    {
      "rule_id": "ADLAW-003",
      "article": "第三条",
      "paragraph": null,
      "item": null,
      "rule_type": "general_principle",
      "text": "广告应当真实、合法，以健康的表现形式表达广告内容，并符合社会主义精神文明建设和弘扬中华民族优秀传统文化的要求。"
    },
    {
      "rule_id": "ADLAW-009-02",
      "article": "第九条",
      "paragraph": "第一款",
      "item": "第二项",
      "rule_type": "content_prohibition",
      "text": "广告不得使用或者变相使用国家机关、国家机关工作人员的名义或者形象。"
    },
    {
      "rule_id": "ADLAW-009-03",
      "article": "第九条",
      "paragraph": "第一款",
      "item": "第三项",
      "rule_type": "content_prohibition",
      "text": "广告不得使用“国家级”、“最高级”、“最佳”等用语。"
    },
    {
      "rule_id": "ADLAW-009-07",
      "article": "第九条",
      "paragraph": "第一款",
      "item": "第七项",
      "rule_type": "content_prohibition",
      "text": "广告不得妨碍社会公共秩序或者违背社会良好风尚。"
    },
    {
      "rule_id": "ADLAW-011-02",
      "article": "第十一条",
      "paragraph": "第二款",
      "item": null,
      "rule_type": "citation_requirement",
      "text": "广告使用数据、统计资料、调查结果、文摘、引用语等引证内容的，应当真实、准确并表明出处；有适用范围和有效期限的，应当明确表示。"
    },
    {
      "rule_id": "ADLAW-015-02",
      "article": "第十五条",
      "paragraph": "第二款",
      "item": null,
      "rule_type": "media_restriction",
      "text": "处方药只能在国务院卫生行政部门和国务院药品监督管理部门共同指定的医学、药学专业刊物上作广告。"
    },
    {
      "rule_id": "ADLAW-017",
      "article": "第十七条",
      "paragraph": null,
      "item": null,
      "rule_type": "content_prohibition",
      "text": "除医疗、药品、医疗器械广告外，其他广告不得涉及疾病治疗功能，也不得使用医疗用语或者易使商品与药品、医疗器械相混淆的用语。"
    },
    {
      "rule_id": "ADLAW-026-01",
      "article": "第二十六条",
      "paragraph": "第一款",
      "item": "第一项",
      "rule_type": "real_estate_restriction",
      "text": "房地产广告不得含有升值或者投资回报的承诺。"
    },
    {
      "rule_id": "ADLAW-026-04",
      "article": "第二十六条",
      "paragraph": "第一款",
      "item": "第四项",
      "rule_type": "real_estate_restriction",
      "text": "房地产广告不得对规划或者建设中的交通、商业、文化教育设施以及其他市政条件作误导宣传。"
    },
    {
      "rule_id": "ADLAW-028",
      "article": "第二十八条",
      "paragraph": null,
      "item": null,
      "rule_type": "false_advertising",
      "text": "广告以虚假或者引人误解的内容欺骗、误导消费者的，构成虚假广告。"
    },
    {
      "rule_id": "ADLAW-046",
      "article": "第四十六条",
      "paragraph": null,
      "item": null,
      "rule_type": "prepublication_review",
      "text": "发布医疗、药品、医疗器械、农药、兽药和保健食品广告，以及法律、行政法规规定应当审查的其他广告，应当在发布前审查；未经审查，不得发布。"
    },
    {
      "rule_id": "ADLAW-055",
      "article": "第五十五条",
      "paragraph": null,
      "item": null,
      "rule_type": "liability",
      "text": "发布虚假广告的，由市场监督管理部门依法责令停止发布、消除影响并处罚款；严重情形适用更高处罚。"
    },
    {
      "rule_id": "ADLAW-057-01",
      "article": "第五十七条",
      "paragraph": "第一款",
      "item": "第一项",
      "rule_type": "liability",
      "text": "发布具有本法第九条、第十条规定禁止情形的广告，适用本项规定的行政责任。"
    },
    {
      "rule_id": "ADLAW-057-02",
      "article": "第五十七条",
      "paragraph": "第一款",
      "item": "第二项",
      "rule_type": "liability",
      "text": "违反本法第十五条规定发布处方药等广告，适用本项规定的行政责任。"
    },
    {
      "rule_id": "ADLAW-058-02",
      "article": "第五十八条",
      "paragraph": "第一款",
      "item": "第二项",
      "rule_type": "liability",
      "text": "违反本法第十七条，在广告中涉及疾病治疗功能或者使用相关医疗用语，适用本项规定的行政责任。"
    },
    {
      "rule_id": "ADLAW-058-08",
      "article": "第五十八条",
      "paragraph": "第一款",
      "item": "第八项",
      "rule_type": "liability",
      "text": "违反本法第二十六条发布房地产广告，适用本项规定的行政责任。"
    },
    {
      "rule_id": "ADLAW-058-14",
      "article": "第五十八条",
      "paragraph": "第一款",
      "item": "第十四项",
      "rule_type": "liability",
      "text": "违反本法第四十六条未经审查发布广告，适用本项规定的行政责任。"
    },
    {
      "rule_id": "ADLAW-059-02",
      "article": "第五十九条",
      "paragraph": "第一款",
      "item": "第二项",
      "rule_type": "liability",
      "text": "广告引证内容违反本法第十一条规定的，适用本项规定的行政责任。"
    }
  ]
}
