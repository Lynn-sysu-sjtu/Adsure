# 本机配置；复制为 .env.video.local 后填写，禁止提交真实 Key。
# 示例：交大 OpenAI-compatible 视觉模型。其他服务须填其支持视觉的模型。
# VIDEO_MVP_VLM_PROVIDER 改为 cloud 后仍须逐任务授权。
VIDEO_MVP_VLM_PROVIDER=local
VIDEO_MVP_CLOUD_BASE_URL=https://models.sjtu.edu.cn/api/v1
VIDEO_MVP_CLOUD_MODEL=qwen3.8-27b
VIDEO_MVP_CLOUD_API_KEY=
VIDEO_MVP_CLOUD_CONSENT=0
# 推荐保持 0，在网页逐任务勾选。无人值守仅限预授权视频哈希白名单：
VIDEO_MVP_CLOUD_ALLOWED_VIDEO_SHA256=
# 1 也必须同时指定精确视频 SHA256 白名单，不能授权所有后续视频。
# 证明文件和活动规则仍只在本机处理。
