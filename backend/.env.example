# Optional Claude-handoff engine settings. Copy to backend/.env locally.
# Never commit backend/.env or any credential value.

# Safe default: deterministic placeholder. Use deepseek only after explicitly
# configuring a destination and key for the intended task.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_ENDPOINT=
LLM_MODEL=deepseek-chat

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Volcengine Seed-ASR (used when ASR_PROVIDER=volcengine).
# x-api-key is a speech-service API key, NOT an IAM AccessKey ID/Secret.
ASR_PROVIDER=mock
# ASR_VOLC_API_KEY=
# ASR_VOLC_RESOURCE_ID=volc.seedasr.auc
# ASR_VOLC_BASE_URL=https://openspeech.bytedance.com
# ASR_VOLC_API_PATH=/api/v3/auc/bigmodel
# ASR_VOLC_MODEL=bigmodel
