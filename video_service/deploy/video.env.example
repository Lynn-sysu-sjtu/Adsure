# Adsure video evidence service environment (no secrets in Git)
VIDEO_SERVICE_HOST=127.0.0.1
VIDEO_SERVICE_PORT=8520
VIDEO_SERVICE_API_KEY=change-me
VIDEO_SERVICE_DATA_DIR=/var/lib/adsure-video
VIDEO_SERVICE_MAX_BYTES=536870912
VIDEO_SERVICE_MAX_SECONDS=1800
VIDEO_SERVICE_MAX_ATTEMPTS=3
VIDEO_SERVICE_STALE_SECONDS=900
VIDEO_SERVICE_MIN_FREE_BYTES=2147483648
VIDEO_SERVICE_SAMPLE_INTERVAL=0.5
VIDEO_SERVICE_MAX_FRAMES=1800
VIDEO_SERVICE_OCR_ENGINE=rapidocr
VIDEO_MVP_OCR_ENGINE=rapidocr
# Cloud providers are disabled unless explicitly configured and task consent is supplied.
VIDEO_MVP_VLM_PROVIDER=local
VIDEO_MVP_ASR_ENGINE=dual
RULE_ENGINE_URL=http://127.0.0.1:8505
RULE_ENGINE_API_KEY=change-me
RULE_ENGINE_CONNECT_TIMEOUT=5
RULE_ENGINE_READ_TIMEOUT=30
RULE_ENGINE_RETRIES=2
